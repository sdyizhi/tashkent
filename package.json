{
  "name": "tashkent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @tashkent/server dev",
    "dev:desktop": "pnpm --filter @tashkent/desktop dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @tashkent/server db:migrate"
  },
  "devDependencies": { "typescript": "^5.9.0" }
}
